<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen: the icon sits straight on the dark background, without the
         light circle the system draws behind it by default. -->
    <style name="Theme.RoverQuest" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/roverquest_dark_background</item>
        <item name="android:statusBarColor">@color/roverquest_dark_background</item>
        <item name="android:navigationBarColor">@color/roverquest_dark_background</item>
        <item name="android:windowSplashScreenBackground">@color/roverquest_dark_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/roverquest_dark_background</item>
    </style>
</resources>
